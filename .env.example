# =============================================================
# Cenkor Admin · 开发环境变量
# 复制为 .env，敏感值填好后 **不要提交**
#
# 两种常见模式：
#   A) docker compose up     → 用下方默认值（容器内 8000，映射宿主机 8000）
#   B) npm run dev + 宝塔后端  → VITE_API_BASE_URL 留空走 vite proxy；
#      后端宿主机端口见 BACKEND_HOST_PORT（通常 8002）
# =============================================================

# ---- 通用 ----
NODE_ENV=development
COMPOSE_PROJECT_NAME=cenkor-admin

# ---- PostgreSQL 16 ----
POSTGRES_DB=cenkor
POSTGRES_USER=cenkor
POSTGRES_PASSWORD=li123456           # ⚠️ 生产前必须改
POSTGRES_PORT=5432

# ---- Redis 7 ----
REDIS_PASSWORD=
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Backend (FastAPI) ----
# Docker：宿主机映射端口（容器内固定 8000）
BACKEND_PORT=8000
# 宝塔/裸机：后端监听端口（与 docker-compose.baota-static 的 BACKEND_HOST_PORT 一致）
BACKEND_HOST_PORT=8002
SECRET_KEY=dev-secret-change-me-32-bytes-min    # ⚠️ 生产前用 openssl rand -hex 32 生成
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库连接（compose 内部用 service 名 "postgres"）
DATABASE_URL=postgresql+asyncpg://cenkor:li123456@postgres:5432/cenkor
DATABASE_URL_SYNC=postgresql://cenkor:li123456@postgres:5432/cenkor

# Redis（compose 内 redis:6379；裸连本机若映射 6380 则改 localhost:6380）
REDIS_URL=redis://redis:6379/0

# MinIO（S3 兼容）
S3_ENDPOINT=http://minio:9000
S3_API_PORT=9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET_PUBLIC=cenkor-public
S3_BUCKET_PRIVATE=cenkor-private
S3_REGION=us-east-1

# 媒体公网 URL 前缀（dev 可指后端；生产填 https://admin.example.com 或 MinIO 反代域）
PUBLIC_BASE_URL=http://localhost:8000

# 飞书 OAuth（可选，登录功能用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:5173/auth/feishu/callback
PORTAL_WEB_PORT=5175

# ---- SMTP（忘记密码 / 通知邮件）----
# 本期仅占位：SMTP_* 字段已添加，前端忘记密码 P1 阶段接入
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cenkor.cn
SMTP_USE_TLS=true

# CORS（与前端 dev 端口一致；Docker admin-web 默认 5173）
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:8000

# ---- Frontend (Vue 3 + Vite) ----
ADMIN_WEB_PORT=5173
# 本地 npm run dev：留空则 vite.config 代理 /api → localhost:8000
# 宝塔静态 dist：留空，同域 /api/ 反代
VITE_API_BASE_URL=
VITE_WS_URL=
