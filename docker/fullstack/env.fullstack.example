# Cenkor Admin · 全栈部署环境变量模板
#
# 推荐用法（自动生成随机密钥，无需手填）：
#   bash scripts/bootstrap-fullstack.sh
#
# 手动用法：
#   cp docker/fullstack/env.fullstack.example .env
#   vim .env                      # 至少设置 POSTGRES_PASSWORD 与 MINIO_ROOT_PASSWORD
#   docker compose -f docker-compose.fullstack.yml up -d --build
#
# ⚠️ 文件名必须是 .env：docker-compose.fullstack.yml 里的服务写死了 `env_file: .env`，
#    而 `--env-file` 只影响 compose 文件的变量插值、不会把变量注入容器。
#    用别的文件名（如 .env.fullstack）会报 `env file .env not found`。
#    .env 已被 .gitignore 忽略，不会被提交。

# ---------- 数据库 ----------
POSTGRES_DB=cenkor
POSTGRES_USER=cenkor
#POSTGRES_PASSWORD=改为强密码

# ---------- 缓存 ----------
REDIS_PASSWORD=

# ---------- 对象存储（MinIO，全栈自带） ----------
MINIO_ROOT_USER=cenkor
#MINIO_ROOT_PASSWORD=改为强密码（≥8位）

# ---------- 安全密钥 ----------
#SECRET_KEY=改为随机值（python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- 存储桶 / 区域 ----------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=cenkor
S3_SECRET_KEY=与 MINIO_ROOT_PASSWORD 一致
S3_BUCKET_PUBLIC=cenkor-public
S3_BUCKET_PRIVATE=cenkor-private
S3_REGION=us-east-1

# ---------- 跨域 / 对外 ----------
CORS_ORIGINS=http://localhost:5185,http://localhost:5192,http://localhost:5175
PUBLIC_BASE_URL=http://localhost:5185

# ---------- 前端构建变量（可选，默认相对路径 /api） ----------
VITE_API_BASE_URL=
VITE_WS_URL=

# ---------- 构建加速（可选） ----------
# 后端镜像安装依赖时的软件源。默认走官方源（任意网络环境都能构建）。
# 中国大陆建议取消下面两行注释换成镜像站，构建会快很多。
#APT_MIRROR=mirrors.aliyun.com
#PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ---------- 全栈对外端口（默认值，已被 compose 锁定后缀 FS_） ----------
FS_BACKEND_PORT=8001
FS_ADMIN_WEB_PORT=5185
FS_PORTAL_WEB_PORT=5192
FS_DEVELOPER_WEB_PORT=5175
FS_POSTGRES_PORT=5543
FS_REDIS_PORT=6382
FS_MINIO_API_PORT=9006
FS_MINIO_CONSOLE_PORT=9007