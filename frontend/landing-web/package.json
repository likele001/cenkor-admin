{
  "name": "landing-web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 9910",
    "build": "npm run docs:sync && vue-tsc --noEmit && vite build",
    "build:spa": "npm run docs:sync && vite build",
    "build:ssr": "npm run docs:sync && vite build --config vite.config.ssr.ts",
    "prerender": "node scripts/prerender.mjs",
    "build:prerender": "npm run build:spa && npm run build:ssr && npm run prerender",
    "preview": "vite preview --port 9910",
    "docs:sync": "node scripts/copy-docs.mjs"
  },
  "dependencies": {
    "@unhead/vue": "^1.11.20",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.31",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/server-renderer": "^3.4.31",
    "sass": "^1.77.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vue-tsc": "^2.0.24"
  }
}
