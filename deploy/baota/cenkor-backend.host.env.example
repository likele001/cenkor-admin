# 宝塔 Python 项目 · 环境变量（宿主机 + Docker 映射）
# 用法：复制为 cenkor-backend.host.env，在宝塔「从文件加载」选此文件
# 路径：/www/wwwroot/cenkor-admin/deploy/baota/cenkor-backend.host.env

PYTHONPATH=/www/wwwroot/cenkor-admin/backend/src
APP_ENV=production
DEBUG=false

# JWT（与 .env.prod 中 SECRET_KEY 保持一致）
SECRET_KEY=请从_env.prod复制

# 数据库 → Docker cenkor-postgres 映射 5433
DATABASE_URL=postgresql+asyncpg://cenkor:li123456@127.0.0.1:5433/cenkor
DATABASE_URL_SYNC=postgresql://cenkor:li123456@127.0.0.1:5433/cenkor

# Redis → Docker cenkor-redis 映射 6380（当前容器无 requirepass，不带密码）
REDIS_URL=redis://127.0.0.1:6380/0

# MinIO → Docker cenkor-minio 映射 9002
S3_ENDPOINT=http://127.0.0.1:9002
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET_PUBLIC=cenkor-public
S3_BUCKET_PRIVATE=cenkor-private
S3_REGION=us-east-1

# 跨域（改成你的域名）
CORS_ORIGINS=https://admin.cenkor.cn,https://portal.cenkor.cn,https://www.cenkor.cn

# 飞书（不用可留空）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://admin.cenkor.cn/auth/feishu/callback
