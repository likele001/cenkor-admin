# 宝塔 Python 项目 · 环境变量（宿主机原生）
# 用法：复制为 cenkor-backend.host.env，在宝塔「从文件加载」选此文件
# 路径：/www/wwwroot/cenkor-admin/deploy/baota/cenkor-backend.host.env
# 注意：宝塔面板的环境变量（env_list）优先级更高，改配置需两处同步，详见 docs/DEPLOY.md §4

PYTHONPATH=/www/wwwroot/cenkor-admin/backend/src
APP_ENV=production
DEBUG=false

# JWT（与 .env.prod 中 SECRET_KEY 保持一致）
SECRET_KEY=请从_env.prod复制

# 数据库 → 宿主机原生 PostgreSQL 5432
DATABASE_URL=postgresql+asyncpg://cenkor:li123456@127.0.0.1:5432/cenkor
DATABASE_URL_SYNC=postgresql://cenkor:li123456@127.0.0.1:5432/cenkor

# Redis → 宿主机原生 Redis 6379，本项目使用 db5
# （宿主 Redis 为全平台共享，db1/db2/db9/db10 已被其他项目占用；改库号前先 DBSIZE 确认该库为空）
REDIS_URL=redis://127.0.0.1:6379/5

# MinIO → 宿主机原生 MinIO 9000
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET_PUBLIC=cenkor-public
S3_BUCKET_PRIVATE=cenkor-private
S3_REGION=us-east-1

# 跨域（改成你的域名）
CORS_ORIGINS=https://admin.cenkor.cn,https://portal.cenkor.cn,https://www.cenkor.cn

# 飞书（不用可留空）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://admin.cenkor.cn/auth/feishu/callback
