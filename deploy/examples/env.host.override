# 宿主机 systemd 覆盖（复制为 deploy/examples/env.host.override 后 systemctl restart cenkor-backend）
# 宿主机原生 PG / Redis / MinIO

DB_HOST=127.0.0.1
DB_HOST_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6379

# 宿主 Redis 未设 requirepass；本项目使用 db5
REDIS_URL=redis://127.0.0.1:6379/5

# 密码为宿主 PostgreSQL 中 cenkor 角色的口令
# DATABASE_URL=postgresql+asyncpg://cenkor:YOUR_PASS@127.0.0.1:5432/cenkor
# DATABASE_URL_SYNC=postgresql://cenkor:YOUR_PASS@127.0.0.1:5432/cenkor
S3_ENDPOINT=http://127.0.0.1:9000
