# 宿主机 systemd 覆盖（复制为 deploy/examples/env.host.override 后 systemctl restart cenkor-backend）
# Docker PG/Redis/MinIO 映射到本机时使用

DB_HOST=127.0.0.1
DB_HOST_PORT=5433
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6380

# 若 Docker Redis 未设 requirepass，留空 REDIS_PASSWORD 并设置：
REDIS_URL=redis://127.0.0.1:6380/0

# 密码与 cenkor-postgres 容器一致（docker inspect cenkor-postgres）
# DATABASE_URL=postgresql+asyncpg://cenkor:YOUR_PASS@127.0.0.1:5433/cenkor
# DATABASE_URL_SYNC=postgresql://cenkor:YOUR_PASS@127.0.0.1:5433/cenkor
S3_ENDPOINT=http://127.0.0.1:9002
