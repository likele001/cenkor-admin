# 宿主机裸跑 backend 时覆盖 .env.prod 中的 Docker 内网地址
# 复制到 .env.prod 末尾，或 export 后执行 restart-backend-host.sh

DB_HOST=127.0.0.1
DB_HOST_PORT=5433
REDIS_HOST=127.0.0.1
REDIS_HOST_PORT=6380

# 示例（密码替换为 gen-secrets.sh 生成的值）：
# DATABASE_URL=postgresql+asyncpg://cenkor:YOUR_PG_PASS@127.0.0.1:5433/cenkor
# DATABASE_URL_SYNC=postgresql://cenkor:YOUR_PG_PASS@127.0.0.1:5433/cenkor
# REDIS_URL=redis://:YOUR_REDIS_PASS@127.0.0.1:6380/0
# S3_ENDPOINT=http://127.0.0.1:9002
