# 可选 · Cenkor 生产域名片段（追加到 .env.prod）
# 核心 gen-secrets.sh 使用通用占位符；部署 cenkor.cn 时合并本文件内容

CORS_ORIGINS=https://www.cenkor.cn,https://cenkor.cn,https://admin.cenkor.cn,https://portal.cenkor.cn
FEISHU_REDIRECT_URI=https://admin.cenkor.cn/auth/feishu/callback
PUBLIC_BASE_URL=https://api.cenkor.cn
VITE_API_BASE_URL=https://api.cenkor.cn
VITE_WS_URL=wss://api.cenkor.cn
