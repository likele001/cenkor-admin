# ============ ERP/CRM 迁移脚本（商业应用，不进公开仓库） ============
# ERP/CRM 迁移脚本全部落在 08-31 之后的日期前缀；平台自身迁移均在 08-19 及以前
backend/alembic/versions/20260831_*.py
backend/alembic/versions/20260901_*.py
backend/alembic/versions/20260902_*.py
backend/alembic/versions/20260903_*.py

# ============ MES 应用（商业闭源，不进公开仓库） ============
# 独立仓库维护：/www/git-repos/cenkor-mes.git（裸仓，含完整版本历史与 tag v0.1.0~v0.7.0）
# 克隆：git clone /www/git-repos/cenkor-mes.git
backend/src/cenkor_admin/apps/mes/
backend/src/cenkor_admin/static/apps/mes/
backend/alembic/versions/2026*_mes_*.py

# ============ 工作流审批（商业闭源，不进公开仓库） ============
# ⚠️ 本应用落在【内置目录】，没有目录级忽略兜底，必须在这里逐条登记。
# 新增商业应用若也放内置目录，照抄下面三行（源码 / 前端产物 / 迁移）——
# 漏登记的后果是 git add -A 会把整份源码与前端产物一起提交进公开仓库。
# 提交前自检：bash scripts/check-app-tracking.sh
backend/src/cenkor_admin/apps/workflow/
backend/src/cenkor_admin/static/apps/workflow/
backend/alembic/versions/2026*_workflow*.py

# ============ 支付中心 + 生态交易层：已开源，随仓交付 ============
# v0.5.11 起 payment（支付中心）与 commerce（定价/订单/授权/云端安装）源码迁回内置目录
# backend/src/cenkor_admin/apps/{payment,commerce}/，与平台同 MIT 授权。
# 迁移脚本同步入库：支付/订单/授权表结构是开源版能跑通结算的必要条件。
# 因此本文件不再为本两者登记任何忽略规则 —— 若你在此处加回忽略，等于把已开源的应用重新闭源。

# ============ 应用 Release 包（构建产物） ============
backend/src/cenkor_admin/apps/*/release/

# ============ 手工备份 / 临时文件 ============
*.bak
*.bak_*
*.bak.*
*.bak-*
*.removed_*
*.orig
*.rej

# cenkor 商城运营平台(开发者注册/发布/收入/提现)——商业资产,不随开源 CMS 发布
frontend/developer-web/

# 同名双份 App 的备份区（把陈旧副本挪出导入路径用，内容仍是闭源应用源码，绝不入库）
backend/.stale-apps/
_rollback_bak_20261014/20261014_124126_create_inventory.py

# ============ 回滚备份 / 构建产物副本（不入库） ============
_rollback_bak_*/
# 功能重写前的临时备份区（含源码副本与截图，只在本地留档）
_bak-*/
*.orphan
*.bak
*.bak_*
*.bak.*
*.before
*.before.*
*.orig
dist.bak.*/

# ===== 闭源应用迁移（2026-10-27 迁移分入子目录后新增）=====
# 与 apps/{crm,erp,mes} 代码同源，属商业实现，绝不进入公开仓库。
backend/alembic/versions/crm/
backend/alembic/versions/erp/
backend/alembic/versions/mes/
# commerce 目录已整体开源（v0.5.11）：10 个迁移全部公开，不再逐条白名单
# 应用自带 schema（方案 D）同样属商业实现，双保险
backend/src/cenkor_admin/apps/*/schema.sql

# ext 目录是混合的：以下 2 个属闭源模块，逐个登记。
#   · 20260925_0027_workflow      —— workflow 应用仍闭源
#   · 20261103_1300_merge_closed  —— 闭源链合流，down_revision 指向 3 个未跟踪
#                                    revision（mes_0009 / workflow_0027 /
#                                    collect_1100），进库会让公开视图断链
#   · 其余（0025_cloud / 0035_app_publish / 0100_app_schema）随 commerce 开源
# 新增闭源 ext 迁移时，必须在此追加，否则 git add -A 会直接带入。
backend/alembic/versions/ext/20260925_0027_workflow.py
backend/alembic/versions/ext/20261103_1300_merge_closed.py

# ===== 一次性运维与迁移补丁脚本（2026-10-30 新增）=====
# 这些是「跑一次就完」的临时脚本：直接改线上数据库、手工改服务商配置、
# 甚至 kill 进程重启。它们不是代码，是操作记录 —— 入库只会让后来的人
# 以为必须执行。结构变更一律走 alembic（backend/alembic/versions/）。
# 特别注意 restart_8002.py：手工启停 Python 进程违反宝塔托管约定，绝不入库。
backend/restart_8002.py
backend/bind_video_capability.py
backend/fix_vision_capability.py
backend/migrate_media_urls.py

# 文档中心 manifest（copy-docs.mjs 生成）
frontend/landing-web/src/config/docs-manifest.generated.ts

# 文档中心构建产物（copy-docs.mjs 生成）
frontend/landing-web/public/docs-content/


# 内容采集 App（商业闭源）迁移目录
backend/alembic/versions/collect/

# 内容采集 App（商业闭源，源码外置 backend/src/apps/collect/）
backend/src/cenkor_admin/static/apps/collect/

# 官网线上目录 frontend/landing（nginx 直接服务 admin.cenkor.cn/landing/）
# 里面的 assets / docs-content / index.html / sitemap.xml / 图标都是
# build-frontends.sh 从 landing-web/dist 同步过来的构建产物，文件名带内容哈希，
# 依赖一升级就全变。入库的代价：每次发版提交一批新文件、旧文件永久留在历史里；
# 而且 package-core.sh 的「跟踪文件被删除」检查会直接掐掉发版
# （v0.5.0 / 0.5.1 / 0.5.2 和 v0.5.15 首次都是这个原因）。
# 产物改由 package-core.sh 从磁盘收集，与另外三套前端的 dist 保持一致。
# 只有下面这几个不参与构建的旧静态页继续入库（可能被外部链接引用）。
frontend/landing/*
!frontend/landing/advantages.html
!frontend/landing/ai-cms.html
!frontend/landing/deploy.html
!frontend/landing/docs.html
!frontend/landing/features.html
!frontend/landing/docs/
!frontend/landing/docs/guide.html
