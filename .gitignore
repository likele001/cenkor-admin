backend/src/cenkor_admin/static/apps/crm/
backend/src/apps/

# ============ ERP/CRM 迁移脚本（商业应用，不进公开仓库） ============
# ERP/CRM 迁移脚本全部落在 08-31 之后的日期前缀；平台自身迁移均在 08-19 及以前
backend/alembic/versions/20260831_*.py
backend/alembic/versions/20260901_*.py
backend/alembic/versions/20260902_*.py
backend/alembic/versions/20260903_*.py

# ============ MES 应用（商业闭源，不进公开仓库） ============
# 独立仓库维护：/www/git-repos/cenkor-mes.git（裸仓，含完整版本历史与 tag v0.1.0~v0.7.0）
# 克隆：git clone /www/git-repos/cenkor-mes.git
backend/src/cenkor_admin/apps/mes/
backend/src/cenkor_admin/static/apps/mes/
backend/alembic/versions/2026*_mes_*.py

# ============ 工作流审批（商业闭源，不进公开仓库） ============
# ⚠️ 本应用落在【内置目录】，没有目录级忽略兜底，必须在这里逐条登记。
# 新增商业应用若也放内置目录，照抄下面三行（源码 / 前端产物 / 迁移）——
# 漏登记的后果是 git add -A 会把整份源码与前端产物一起提交进公开仓库。
# 提交前自检：bash scripts/check-app-tracking.sh
backend/src/cenkor_admin/apps/workflow/
backend/src/cenkor_admin/static/apps/workflow/
backend/alembic/versions/2026*_workflow*.py

# ============ 支付中心应用（独立应用，不公开源码） ============
# 源码已迁至外置应用目录 backend/src/apps/payment/，由上面的 backend/src/apps/ 规则整体覆盖，
# 无需为本应用单独登记。下面两条仅因前端产物与迁移仍落在被跟踪的目录里：
backend/src/cenkor_admin/static/apps/payment/
backend/alembic/versions/2026*_payment*.py

# 生态交易层（定价 / 订单 / 授权 / 云端安装，闭源）—— 源码在 backend/src/apps/commerce/，
# 同样被上面的 backend/src/apps/ 规则整体覆盖；这里只补迁移文件。
backend/alembic/versions/2026*_commerce*.py
# 兜底：防止误把应用放回内置目录
backend/src/cenkor_admin/apps/payment/

# ============ 应用 Release 包（构建产物） ============
backend/src/cenkor_admin/apps/*/release/

# ============ 手工备份 / 临时文件 ============
*.bak
*.bak_*
*.bak.*
*.removed_*
*.orig
*.rej

# 双边结算（钱包 / 流水 / 提现，闭源）—— 源码头文件在 backend/src/apps/commerce/ 已整体忽略，这里补迁移文件。
backend/alembic/versions/2026*_marketplace*.py
backend/alembic/versions/2026*_payout*.py

# cenkor 商城运营平台(开发者注册/发布/收入/提现)——商业资产,不随开源 CMS 发布
frontend/developer-web/

# 应用定价：原价（划线价）与限时促销（闭源 commerce 的迁移，源码同样在 backend/src/apps/ 被整体忽略）
backend/alembic/versions/2026*_promo*.py

# 应用市场云端绑定（实例凭证 / 一次性绑定码）——闭源 commerce 的迁移，
# 源码同样在 backend/src/apps/ 被整体忽略。
backend/alembic/versions/2026*_cloud*.py
