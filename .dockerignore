# 根级 .dockerignore —— 仅影响以仓库根为构建上下文的全栈构建
#   （docker/fullstack/*.Dockerfile）。现有 dev by context=./backend 与
#   ./frontend/* 各自用子目录 .dockerignore，不受影响。

# version control
.git
.gitignore

# ---- 商业闭源应用（源码/产物外置，不入 git，禁止进镜像）----
# backend/src/apps/ 现仅存 collect（内容采集，商业闭源）；
# static/apps 下 erp / crm / mes / workflow / collect 同属商业实现。
# docker/fullstack/backend.Dockerfile 的 `COPY backend/src ./src` 会整棵拷走。
backend/src/apps/
backend/src/cenkor_admin/static/apps/erp/
backend/src/cenkor_admin/static/apps/crm/
backend/src/cenkor_admin/static/apps/mes/
backend/src/cenkor_admin/static/apps/workflow/
backend/src/cenkor_admin/static/apps/collect/

# node / npm
node_modules
frontend/*/node_modules
frontend/*/dist

# python 产物
backend/__pycache__
backend/.venv
backend/venv
*.pyc

# 敏感文件（勿打进镜像）
backend/.env
.env
.env.prod
*.local
deploy/nginx/certs

# 无关构建产物
backend/tests
tests
docs
release
*.zip
*.log
.DS_Store
.idea
.vscode